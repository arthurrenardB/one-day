# URL publique du site (liens magiques, retours Stripe). Ex : https://oneday.app
APP_URL=

# Génération des relances (Claude). Sans cette clé : relances d'exemple (mode démo).
ANTHROPIC_API_KEY=

# Base de données libSQL. Vide = fichier local ./data/oneday.db.
# En production (Vercel…), utilise Turso : libsql://ton-db.turso.io + jeton.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Emails de connexion (Resend). Sans clé : le lien s'affiche dans la console (et à l'écran en dev).
# Accès démo : connexion directe sans e-mail, offre « À vie ». Séparés par des virgules.
DEMO_EMAILS=

RESEND_API_KEY=
EMAIL_FROM="One Day <bonjour@ton-domaine.fr>"

# Paiement Stripe. Sans STRIPE_SECRET_KEY : paiement simulé, en dev uniquement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK10=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_VIP=

# Vérification Google Search Console (balise meta)
GOOGLE_SITE_VERIFICATION=

# Mot de passe du tableau de bord admin (/admin)
ADMIN_PASSWORD=
